GH_CLIENT_ID=replace-with-github-oauth-client-id
GH_CLIENT_SECRET=replace-with-github-oauth-client-secret
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:5173
