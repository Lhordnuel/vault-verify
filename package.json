{
  "name": "attest-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, evidence-backed developer credentials.",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @attest/web",
    "dev:api": "npm run dev -w @attest/api",
    "build": "npm run build -w @attest/core && npm run build -w attest && npm run build -w @attest/api && npm run build -w @attest/web",
    "typecheck": "npm run build -w @attest/core && npm run typecheck -w attest && npm run typecheck -w @attest/api && npm run typecheck -w @attest/web",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}