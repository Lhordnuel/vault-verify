# Local secrets for vault-verify (Q1). Never commit the real .env:
# it is gitignored AND blocked by the pre-commit secret check.
# Service-side keys live in Supabase function secrets instead:
#   supabase secrets set ANCHOR_SIGNING_KEY=...
# Link this checkout to your Supabase project once (ref from dashboard):
#   supabase login
#   supabase link --project-ref <ref>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: identifies the harness/collector writing evidence.
HARNESS_ENV=local
